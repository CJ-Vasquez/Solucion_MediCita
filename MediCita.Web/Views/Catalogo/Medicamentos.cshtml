@model List<MediCita.Web.Entidades.Medicamento>
@{
    ViewData["Title"] = "Botica - Catálogo de Medicamentos";
}

<div class="container-fluid py-5">
    <!-- Header -->
    <div class="text-center mb-5">
        <div class="mb-3">
            <i class="bi bi-capsule-pill" style="font-size: 3.5rem; color: #667eea;"></i>
        </div>
        <h2 class="display-5 fw-bold mb-3">Catálogo de Farmacia</h2>
        <div class="mx-auto mb-3" style="width: 100px; height: 4px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 2px;"></div>
        <p class="lead text-muted">Encuentra los mejores medicamentos al mejor precio</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filtros -->
    <div class="row mb-4 justify-content-center">
        <div class="col-lg-10">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-2">
                            <div class="input-group">
                                <span class="input-group-text bg-white border-0">
                                    <i class="bi bi-search text-muted"></i>
                                </span>
                                <input type="text" id="searchMedicamento" class="form-control border-0" placeholder="Buscar medicamento...">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <select class="form-select shadow-sm" id="filterLaboratorio"
                            style="border-radius: 10px; padding: 0.75rem;">
                        <option value="">Todos los laboratorios</option>
                        @foreach (var lab in Model.Select(m => m.Laboratorio).Distinct().OrderBy(l => l))
                        {
                            <option value="@lab">@lab</option>
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Catálogo -->
    <div class="row g-4" id="catalogoContainer">
        @if (Model == null || Model.Count == 0)
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
                <h4 class="text-muted">No hay medicamentos disponibles</h4>
            </div>
        }
        else
        {
            int contador = 1;

            @foreach (var medicamento in Model)
            {
                // USAR NÚMERO SECUENCIAL: medicina1.jpg, medicina2.jpg, etc.
                var imageUrl = $"/images/medicinas/medicina{contador}.jpg";
                var fallbackUrl = $"https://via.placeholder.com/400x300/667eea/ffffff?text={Uri.EscapeDataString(medicamento.Nombre.Substring(0, Math.Min(15, medicamento.Nombre.Length)))}";

                <div class="col-lg-3 col-md-4 col-sm-6 medicamento-item"
                     data-nombre="@medicamento.Nombre.ToLower()"
                     data-laboratorio="@medicamento.Laboratorio"
                     data-precio="@medicamento.Precio">
                    <div class="card h-100 shadow-sm hover-card border-0">
                        <div class="position-relative overflow-hidden">
                            @if (medicamento.Stock > 0)
                            {
                                <span class="position-absolute top-0 start-0 m-2 badge bg-success px-3 py-2 rounded-pill" style="z-index: 1;">
                                    <i class="bi bi-check-circle me-1"></i> Disponible
                                </span>
                            }
                            else
                            {
                                <span class="position-absolute top-0 start-0 m-2 badge bg-danger px-3 py-2 rounded-pill" style="z-index: 1;">
                                    <i class="bi bi-x-circle me-1"></i> Agotado
                                </span>
                            }

                            <!-- Imagen -->
                            <img src="@imageUrl"
                                 class="card-img-top"
                                 alt="@medicamento.Nombre"
                                 style="height: 220px; object-fit: cover;"
                                 onerror="this.onerror=null;this.src='@fallbackUrl';">
                        </div>

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold text-truncate" title="@medicamento.Nombre">
                                @medicamento.Nombre
                            </h5>

                            <p class="text-muted small mb-2">
                                <i class="bi bi-building me-1"></i>@medicamento.Laboratorio
                            </p>

                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="fs-4 fw-bold text-primary">S/ @medicamento.Precio.ToString("N2")</span>
                                    <span class="badge @(medicamento.Stock > 10 ? "bg-success" : medicamento.Stock > 0 ? "bg-warning text-dark" : "bg-danger")">
                                        Stock: @medicamento.Stock
                                    </span>
                                </div>

                                @if (medicamento.Stock > 0)
                                {
                                    <button class="btn btn-primary w-100" onclick="agregarAlCarrito(@medicamento.IdMedicamento)">
                                        <i class="bi bi-cart-plus me-2"></i>Agregar al Carrito
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-secondary w-100" disabled>
                                        <i class="bi bi-x-circle me-2"></i>No Disponible
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                contador++;
            }
        }
    </div>

    <!-- Info adicional -->
    <div class="row mt-5 g-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm text-center p-4 h-100">
                <i class="bi bi-truck fs-1 text-primary mb-3"></i>
                <h5 class="fw-bold">Envío Rápido</h5>
                <p class="text-muted mb-0">Recibe tus medicamentos en 24-48 horas</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm text-center p-4 h-100">
                <i class="bi bi-shield-check fs-1 text-success mb-3"></i>
                <h5 class="fw-bold">Productos Garantizados</h5>
                <p class="text-muted mb-0">Todos nuestros medicamentos están certificados</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm text-center p-4 h-100">
                <i class="bi bi-headset fs-1 text-info mb-3"></i>
                <h5 class="fw-bold">Soporte 24/7</h5>
                <p class="text-muted mb-0">Estamos aquí para ayudarte en todo momento</p>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-card {
        transition: all 0.3s ease;
    }

        .hover-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.15) !important;
        }
</style>

@section Scripts {
    <script>
        document.getElementById('searchMedicamento').addEventListener('keyup', filtrarMedicamentos);
        document.getElementById('filterLaboratorio').addEventListener('change', filtrarMedicamentos);

        function filtrarMedicamentos() {
            const searchTerm = document.getElementById('searchMedicamento').value.toLowerCase();
            const laboratorio = document.getElementById('filterLaboratorio').value;
            const items = document.querySelectorAll('.medicamento-item');

            items.forEach(item => {
                const nombre = item.dataset.nombre;
                const lab = item.dataset.laboratorio;
                const matchSearch = nombre.includes(searchTerm);
                const matchLab = laboratorio === '' || lab === laboratorio;
                item.style.display = matchSearch && matchLab ? '' : 'none';
            });
        }

        function agregarAlCarrito(idMedicamento) {
            const toast = document.createElement('div');
            toast.className = 'alert alert-success alert-dismissible fade show position-fixed top-0 end-0 m-3';
            toast.style.zIndex = '9999';
            toast.innerHTML = `
                <i class="bi bi-check-circle me-2"></i> Medicamento agregado al carrito
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
        }
    </script>
}
