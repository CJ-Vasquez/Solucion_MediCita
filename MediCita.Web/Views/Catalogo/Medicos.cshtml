@model List<MediCita.Web.Entidades.Medico>
@{
    ViewData["Title"] = "Nuestros Médicos";
    var especialidades = ViewBag.Especialidades as List<string> ?? new List<string>();
}

<div class="container-fluid py-5" style="background: linear-gradient(to bottom, #f8f9fa 0%, #ffffff 100%);">
    <!-- HEADER -->
    <div class="text-center mb-5">
        <div class="mb-3">
            <i class="bi bi-people-fill" style="font-size: 3.5rem; color: #667eea;"></i>
        </div>
        <h1 class="display-5 fw-bold mb-3">Nuestros Médicos Especialistas</h1>
        <div class="mx-auto mb-3" style="width: 100px; height: 4px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 2px;"></div>
        <p class="lead text-muted">Conoce a nuestro equipo de profesionales altamente capacitados</p>
    </div>

    <!-- FILTROS -->
    <div class="row justify-content-center mb-5">
        <div class="col-lg-8">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-2">
                            <div class="input-group">
                                <span class="input-group-text bg-white border-0">
                                    <i class="bi bi-search text-muted"></i>
                                </span>
                                <input type="text" id="searchMedico" class="form-control border-0"
                                       placeholder="Buscar médico...">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <select class="form-select shadow-sm" id="filterEspecialidad"
                            style="border-radius: 10px; padding: 0.75rem;">
                        <option value="">Todas las Especialidades</option>
                        @foreach (var esp in especialidades)
                        {
                            <option value="@esp">@esp</option>
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- GRID DE MÉDICOS -->
    <div class="row g-4" id="medicosContainer">
        @{
            int contador = 1;
        }
        @foreach (var medico in Model.OrderBy(m => m.NombreCompleto))
        {
            var especialidadNombre = medico.Especialidad?.NombreEspec ?? "General";

            // USAR NÚMERO SECUENCIAL: medico1.jpg, medico2.jpg, etc.
            var avatarUrl = $"/images/medicos/medico{contador}.jpg";
            var fallbackUrl = $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(medico.NombreCompleto)}&background=667eea&color=fff&size=200&bold=true";

            <div class="col-lg-3 col-md-4 col-sm-6 medico-item"
                 data-nombre="@medico.NombreCompleto.ToLower()"
                 data-especialidad="@especialidadNombre">
                <div class="card border-0 shadow-sm h-100 hover-card">
                    <!-- Badge -->
                    <div class="position-absolute top-0 end-0 p-3" style="z-index: 1;">
                        <span class="badge bg-success rounded-pill px-3 py-2">
                            <i class="bi bi-check-circle me-1"></i>Disponible
                        </span>
                    </div>

                    <!-- Avatar -->
                    <div class="text-center pt-4">
                        <img src="@avatarUrl"
                             class="rounded-circle shadow"
                             alt="@medico.NombreCompleto"
                             style="width: 120px; height: 120px; object-fit: cover;"
                             onerror="this.onerror=null;this.src='@fallbackUrl';">
                    </div>

                    <!-- Contenido -->
                    <div class="card-body text-center">
                        <h5 class="card-title fw-bold mb-2">Dr(a). @medico.NombreCompleto</h5>
                        <p class="text-muted small mb-3">
                            <i class="bi bi-heart-pulse me-1"></i>@especialidadNombre
                        </p>

                        <div class="mb-3 small text-muted text-start">
                            <div class="mb-1">
                                <i class="bi bi-card-text me-2"></i>CMP: @medico.CMP
                            </div>
                            <div class="mb-1">
                                <i class="bi bi-envelope me-2"></i>@medico.Correo
                            </div>
                            <div class="mb-1">
                                <i class="bi bi-telephone me-2"></i>@medico.Telefono
                            </div>
                        </div>

                        <a asp-controller="Citas" asp-action="Index" class="btn btn-gradient-primary w-100">
                            <i class="bi bi-calendar-plus me-2"></i>Reservar Cita
                        </a>
                    </div>
                </div>
            </div>
            
            contador++;
        }
    </div>
</div>

<style>
    .hover-card {
        transition: all 0.3s ease;
    }

        .hover-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.1) !important;
        }
</style>

@section Scripts {
    <script>
        document.getElementById('searchMedico').addEventListener('keyup', filtrarMedicos);
        document.getElementById('filterEspecialidad').addEventListener('change', filtrarMedicos);

        function filtrarMedicos() {
            const searchTerm = document.getElementById('searchMedico').value.toLowerCase();
            const especialidad = document.getElementById('filterEspecialidad').value;
            const items = document.querySelectorAll('.medico-item');

            items.forEach(item => {
                const nombre = item.dataset.nombre;
                const esp = item.dataset.especialidad;
                const matchSearch = nombre.includes(searchTerm);
                const matchEsp = especialidad === '' || esp === especialidad;
                item.style.display = matchSearch && matchEsp ? '' : 'none';
            });
        }
    </script>
}
