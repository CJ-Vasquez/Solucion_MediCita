@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="es" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MediCita</title>

    <!-- Bootstrap & estilos base -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- SweetAlert2 CSS (para diálogos y toasts) -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">

    <style>
        /* ========================================
                   VARIABLES DE COLOR - GRADIENTE PRINCIPAL
                   ======================================== */
        :root {
            --gradient-primary: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --color-primary: #667eea;
            --color-secondary: #764ba2;
        }

        .bg-gradient-primary {
            background: var(--gradient-primary);
        }

        .navbar-brand i {
            color: #ffd700 !important;
            text-shadow: 0 0 10px rgba(255, 215, 0, 0.5);
        }

        /* ========================================
                   ESTILOS DEL CARRITO
                   ======================================== */
        .cart-badge {
            font-size: 0.65rem;
            padding: 0.25em 0.5em;
            min-width: 1.2rem;
            animation: pulse 1.5s infinite;
        }

        @@keyframes pulse {
            0%, 100% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.1);
            }
        }

        .btn-icon:hover i {
            transform: scale(1.15);
            transition: transform 0.2s;
        }

        /* ========================================
                   MODALES 
                   ======================================== */
        .modal-content {
            border-radius: 20px;
            overflow: hidden;
            border: none;
        }

        .modal-header {
            background: var(--gradient-primary);
            border: none;
            padding: 1.5rem;
        }

        .modal-title {
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .modal-body {
            padding: 2rem;
        }

        .form-control, .form-floating > .form-control {
            border-radius: 12px;
            border: 2px solid #e0e0e0;
            padding: 0.75rem 1rem;
            transition: all 0.3s;
        }

            .form-control:focus {
                border-color: var(--color-primary);
                box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
            }

        .btn-gradient-primary {
            background: var(--gradient-primary);
            border: none;
            color: white;
            font-weight: 600;
            letter-spacing: 0.5px;
            transition: all 0.3s;
        }

            .btn-gradient-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
            }

        .btn-gradient-success {
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            border: none;
            color: white;
            font-weight: 600;
        }

            .btn-gradient-success:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(17, 153, 142, 0.4);
            }

        /* ========================================
                   FOOTER
                   ======================================== */
        footer a {
            transition: all 0.3s ease;
        }

            footer a:hover {
                color: var(--color-primary) !important;
                transform: translateX(5px);
            }

        .social-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
        }

            .social-icon:hover {
                background: var(--color-primary);
                transform: translateY(-5px);
                box-shadow: 0 8px 15px rgba(102, 126, 234, 0.4);
            }

        .policy-link {
            cursor: pointer;
            transition: all 0.3s;
        }

            .policy-link:hover {
                color: var(--color-primary) !important;
                text-decoration: underline !important;
            }

        /* ========================================
                   ESTILOS ESPECIALES PARA MODAL LOGIN
                   ======================================== */
        #loginModal .modal-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 2.5rem 2rem;
        }

        #loginModal .form-label {
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #6c757d;
            margin-bottom: 0.5rem;
        }

        #loginModal .input-group-text {
            background-color: #f8f9fa;
            border: 2px solid #e0e0e0;
            border-right: none;
            padding: 0.75rem 1rem;
        }

        #loginModal .input-group .form-control {
            border-left: none;
            padding-left: 0.5rem;
        }

        #loginModal .input-group:focus-within .input-group-text {
            border-color: var(--color-primary);
            background-color: #fff;
        }
    </style>
</head>
<body class="d-flex flex-column h-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-gradient-primary shadow-sm sticky-top" style="z-index: 1030;">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold fs-3 d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-hospital-fill me-2"></i>
                    <span class="text-white">MediCita</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">

                    @if (User.Identity!.IsAuthenticated)
                    {
                        var rolUsuario = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;

                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            @if (rolUsuario == "Paciente")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Venta" asp-action="Catalogo">
                                        <i class="bi bi-capsule"></i> Botica
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Catalogo" asp-action="Medicos">
                                        <i class="bi bi-person-badge"></i> Médicos
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Catalogo" asp-action="Especialidades">
                                        <i class="bi bi-heart-pulse"></i> Especialidades
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Cliente" asp-action="Dashboard">
                                        <i class="bi bi-speedometer2"></i> Mi Panel
                                    </a>
                                </li>
                            }
                            else if (rolUsuario == "Medico")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Medico" asp-action="Dashboard">
                                        <i class="bi bi-speedometer2"></i> Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Medico" asp-action="MisCitas">
                                        <i class="bi bi-calendar-check"></i> Mis Citas
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Medico" asp-action="MiPerfil">
                                        <i class="bi bi-person-circle"></i> Mi Perfil
                                    </a>
                                </li>
                            }
                            else if (rolUsuario == "Administrador" || rolUsuario == "Admin")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Admin" asp-action="Dashboard">
                                        <i class="bi bi-speedometer2"></i> Dashboard
                                    </a>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-white" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-gear"></i> Gestión
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Medicos"><i class="bi bi-person-badge me-2"></i> Médicos</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Medicamentos"><i class="bi bi-capsule me-2"></i> Medicamentos</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Especialidades"><i class="bi bi-heart-pulse me-2"></i> Especialidades</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Usuarios"><i class="bi bi-people me-2"></i> Usuarios</a></li>
                                    </ul>
                                </li>
                            }
                        </ul>

                        <ul class="navbar-nav ms-auto align-items-center">
                            @if (rolUsuario == "Paciente")
                            {
                                <li class="nav-item me-3">
                                    <a class="nav-link position-relative btn-icon" asp-controller="Venta" asp-action="Carrito">
                                        <i class="bi bi-cart3 fs-4 text-white"></i>
                                        @{
                                            var cantidadCarrito = Context.Session.GetInt32("CantidadCarrito") ?? 0;
                                            if (cantidadCarrito > 0)
                                            {
                                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-success cart-badge">
                                                    @cantidadCarrito
                                                </span>
                                            }
                                        }
                                    </a>
                                </li>
                            }

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white fw-bold d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle fs-5 me-2"></i>
                                    <span class="d-none d-md-inline">@User.Identity.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                    @if (rolUsuario == "Paciente")
                                    {
                                        <li><a class="dropdown-item" asp-controller="Cliente" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2"></i> Mi Dashboard</a></li>
                                        <li><a class="dropdown-item" asp-controller="Cliente" asp-action="MisCitas"><i class="bi bi-calendar-check me-2"></i> Mis Citas</a></li>
                                        <li><a class="dropdown-item" asp-controller="Cliente" asp-action="MisCompras"><i class="bi bi-bag-check me-2"></i> Mis Compras</a></li>
                                    }
                                    else if (rolUsuario == "Medico")
                                    {
                                        <li><a class="dropdown-item" asp-controller="Medico" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2"></i> Dashboard</a></li>
                                        <li><a class="dropdown-item" asp-controller="Medico" asp-action="MisCitas"><i class="bi bi-calendar-check me-2"></i> Mis Citas</a></li>
                                        <li><a class="dropdown-item" asp-controller="Medico" asp-action="MiPerfil"><i class="bi bi-person-circle me-2"></i> Mi Perfil</a></li>
                                    }
                                    else if (rolUsuario == "Administrador" || rolUsuario == "Admin")
                                    {
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2"></i> Dashboard Admin</a></li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Acceso" asp-action="Salir">
                                            <i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house"></i> Inicio
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Venta" asp-action="Catalogo">
                                    <i class="bi bi-capsule"></i> Botica
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Catalogo" asp-action="Medicos">
                                    <i class="bi bi-person-badge"></i> Médicos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Catalogo" asp-action="Especialidades">
                                    <i class="bi bi-heart-pulse"></i> Especialidades
                                </a>
                            </li>
                        </ul>

                        <ul class="navbar-nav ms-auto align-items-center">
                            <li class="nav-item me-3">
                                <a class="nav-link position-relative btn-icon" asp-controller="Venta" asp-action="Carrito">
                                    <i class="bi bi-cart3 fs-4 text-white"></i>
                                    @{
                                        var cantidadCarritoPublico = Context.Session.GetInt32("CantidadCarrito") ?? 0;
                                        if (cantidadCarritoPublico > 0)
                                        {
                                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-success cart-badge">
                                                @cantidadCarritoPublico
                                            </span>
                                        }
                                    }
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-white" href="#" data-bs-toggle="modal" data-bs-target="#registroModal">
                                    <i class="bi bi-person-plus"></i> Registrarse
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" href="#" data-bs-toggle="modal" data-bs-target="#loginModal">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Ingresar
                                </a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="flex-grow-1 position-relative">
        @* TOASTS BOOTSTRAP CENTRO ABAJO *@
        <div class="toast-container position-fixed bottom-0 start-50 translate-middle-x p-3 mb-4" style="z-index: 2000;">
            @if (TempData["Mensaje"] != null)
            {
                <div class="toast show align-items-center text-white bg-success border-0 shadow-lg" role="alert">
                    <div class="d-flex">
                        <div class="toast-body fs-6 fw-bold px-4 py-3">
                            <i class="bi bi-check-circle-fill me-2 fs-5"></i> @TempData["Mensaje"]
                        </div>
                        <button type="button" class="btn-close btn-close-white me-3 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            }
            @if (TempData["Exito"] != null)
            {
                <div class="toast show align-items-center text-white border-0 shadow-lg" role="alert" style="background: var(--gradient-primary);">
                    <div class="d-flex">
                        <div class="toast-body fs-6 fw-bold px-4 py-3">
                            <i class="bi bi-bag-check-fill me-2 fs-5"></i> @TempData["Exito"]
                        </div>
                        <button type="button" class="btn-close btn-close-white me-3 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="toast show align-items-center text-white bg-danger border-0 shadow-lg" role="alert">
                    <div class="d-flex">
                        <div class="toast-body fs-6 fw-bold px-4 py-3">
                            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i> @TempData["Error"]
                        </div>
                        <button type="button" class="btn-close btn-close-white me-3 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            }
        </div>

        <main role="main">
            @RenderBody()
        </main>
    </div>

    @* ========================================
       MODAL LOGIN 
       ======================================== *@
    <div class="modal fade" id="loginModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header text-white border-0 text-center">
                    <div class="w-100">
                        <i class="bi bi-hospital-fill" style="font-size: 3.5rem; color: #ffd700;"></i>
                        <h3 class="modal-title mt-3 mb-2" style="font-weight: 700;">Bienvenido</h3>
                        <p class="mb-0 opacity-90">Ingresa a tu cuenta MediCita</p>
                    </div>
                    <button type="button" class="btn-close btn-close-white position-absolute"
                            style="top: 1rem; right: 1rem;"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body p-4" style="background: #fff;">
                    <form asp-controller="Acceso" asp-action="LoginModal" method="post">
                        @if (TempData["ErrorLogin"] != null)
                        {
                            <div class="alert alert-danger rounded-3 d-flex align-items-center mb-3">
                                <i class="bi bi-exclamation-circle fs-5 me-2"></i>
                                <span>@TempData["ErrorLogin"]</span>
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label">Correo Electrónico</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-envelope"></i>
                                </span>
                                <input type="email" name="correo" class="form-control"
                                       placeholder="tucorreo@ejemplo.com" required />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-lock"></i>
                                </span>
                                <input type="password" name="clave" class="form-control"
                                       placeholder="••••••••" required />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-gradient-primary w-100 btn-lg py-3 fw-bold">
                            INGRESAR
                        </button>
                    </form>

                    <div class="text-center mt-4">
                        <p class="text-muted mb-0">
                            ¿No tienes cuenta?
                            <a href="#" data-bs-toggle="modal" data-bs-target="#registroModal"
                               data-bs-dismiss="modal" class="fw-bold text-decoration-none"
                               style="color: var(--color-primary);">
                                Crear cuenta
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ========================================
       MODAL REGISTRO
       ======================================== *@
    <div class="modal fade" id="registroModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow-lg">
                <div class="modal-header text-white" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">
                    <h5 class="modal-title w-100 text-center">
                        <i class="bi bi-person-plus me-2"></i>Crear Cuenta Nueva
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form asp-controller="Acceso" asp-action="RegistrarCliente" method="post">
                        @if (TempData["ErrorRegistro"] != null)
                        {
                            <div class="alert alert-danger rounded-3 text-center">
                                <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorRegistro"]
                            </div>
                        }
                        <div class="mb-3">
                            <label class="form-label fw-bold"><i class="bi bi-person me-2"></i>Nombre Completo</label>
                            <input type="text" name="nombreCompleto" class="form-control" placeholder="Ej: Juan Pérez García" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold"><i class="bi bi-envelope me-2"></i>Correo Electrónico</label>
                            <input type="email" name="correo" class="form-control" placeholder="correo@ejemplo.com" required />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold"><i class="bi bi-lock me-2"></i>Contraseña</label>
                                <input type="password" name="clave" class="form-control" placeholder="Mínimo 6 caracteres" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold"><i class="bi bi-lock-fill me-2"></i>Confirmar Contraseña</label>
                                <input type="password" name="confirmarClave" class="form-control" placeholder="Repetir contraseña" required />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-gradient-success w-100 btn-lg rounded-3">
                            <i class="bi bi-person-plus me-2"></i>CREAR CUENTA
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @* ========================================
       MODAL POLÍTICA DE PRIVACIDAD
       ======================================== *@
    <div class="modal fade" id="politicaModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content shadow-lg">
                <div class="modal-header text-white">
                    <h5 class="modal-title"><i class="bi bi-shield-check me-2"></i>Política de Privacidad</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <h6 class="fw-bold">1. Recopilación de Información</h6>
                    <p>En MediCita recopilamos información personal como nombre, correo electrónico, y datos médicos necesarios para brindar nuestros servicios de forma eficiente y segura.</p>

                    <h6 class="fw-bold mt-3">2. Uso de la Información</h6>
                    <p>Utilizamos su información para gestionar citas médicas, procesar compras en nuestra botica, y mejorar nuestros servicios. No compartimos sus datos con terceros sin su consentimiento.</p>

                    <h6 class="fw-bold mt-3">3. Seguridad de Datos</h6>
                    <p>Implementamos medidas de seguridad técnicas y organizativas para proteger su información personal contra accesos no autorizados, pérdida o alteración.</p>

                    <h6 class="fw-bold mt-3">4. Derechos del Usuario</h6>
                    <p>Usted tiene derecho a acceder, rectificar o eliminar sus datos personales en cualquier momento. Contáctenos para ejercer estos derechos.</p>

                    <p class="text-muted small mt-4"><i class="bi bi-calendar3 me-2"></i>Última actualización: Diciembre 2025</p>
                </div>
            </div>
        </div>
    </div>

    @* ========================================
       MODAL TÉRMINOS Y CONDICIONES
       ======================================== *@
    <div class="modal fade" id="terminosModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content shadow-lg">
                <div class="modal-header text-white">
                    <h5 class="modal-title"><i class="bi bi-file-text me-2"></i>Términos y Condiciones</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <h6 class="fw-bold">1. Aceptación de Términos</h6>
                    <p>Al utilizar MediCita, usted acepta estos términos y condiciones en su totalidad. Si no está de acuerdo, por favor no utilice nuestros servicios.</p>

                    <h6 class="fw-bold mt-3">2. Servicios Ofrecidos</h6>
                    <p>MediCita ofrece servicios de reserva de citas médicas, consulta de especialidades, y compra de medicamentos a través de nuestra botica virtual.</p>

                    <h6 class="fw-bold mt-3">3. Responsabilidades del Usuario</h6>
                    <p>El usuario se compromete a proporcionar información veraz y actualizada, y a utilizar los servicios de forma responsable y conforme a la ley.</p>

                    <h6 class="fw-bold mt-3">4. Cancelaciones y Reembolsos</h6>
                    <p>Las citas pueden cancelarse con al menos 24 horas de anticipación. Los reembolsos de compras se procesarán según nuestra política de devoluciones.</p>

                    <h6 class="fw-bold mt-3">5. Limitación de Responsabilidad</h6>
                    <p>MediCita no se hace responsable por diagnósticos médicos. Nuestros servicios facilitan la conexión entre pacientes y profesionales de la salud.</p>

                    <p class="text-muted small mt-4"><i class="bi bi-calendar3 me-2"></i>Última actualización: Diciembre 2025</p>
                </div>
            </div>
        </div>
    </div>

