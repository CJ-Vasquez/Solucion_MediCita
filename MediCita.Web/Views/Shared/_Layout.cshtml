    <!-- SweetAlert2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Inicializar toasts Bootstrap (centro abajo)
        document.addEventListener('DOMContentLoaded', function () {
            var toastElList = [].slice.call(document.querySelectorAll('.toast'));
            toastElList.map(function (toastEl) {
                return new bootstrap.Toast(toastEl, { delay: 4000 }).show();
            });
        });
    </script>

    @if (TempData["ErrorLogin"] != null || TempData["MostrarLogin"] != null)
    {
        <script>
            new bootstrap.Modal(document.getElementById('loginModal')).show();
        </script>
    }
    @if (TempData["ErrorRegistro"] != null)
    {
        <script>
            new bootstrap.Modal(document.getElementById('registroModal')).show();
