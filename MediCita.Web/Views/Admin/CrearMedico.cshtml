@model MediCita.Web.Entidades.Medico
@{
    ViewData["Title"] = "Nuevo Médico";
    var especialidades = ViewBag.Especialidades as List<MediCita.Web.Entidades.Especialidad> ?? new();
}

<div class="container-fluid py-4">
    <div class="card shadow-sm border-0">
        <div class="card-header" style="background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);">
            <h3 class="text-white mb-0"><i class="bi bi-person-plus me-2"></i>Registrar Médico</h3>
        </div>
        <div class="card-body p-4">
            <form asp-action="CrearMedico" method="post">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Nombre Completo</label>
                        <input asp-for="NombreCompleto" class="form-control" />
                        <span asp-validation-for="NombreCompleto" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">CMP</label>
                        <input asp-for="CMP" class="form-control" />
                        <span asp-validation-for="CMP" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Especialidad</label>
                        <select asp-for="IdEspecialidad" class="form-select">
                            <option value="">-- Seleccione --</option>
                            @foreach (var e in especialidades)
                            {
                                <option value="@e.IdEspecialidad">@e.NombreEspec</option>
                            }
                        </select>
                        <span asp-validation-for="IdEspecialidad" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Correo</label>
                        <input asp-for="Correo" class="form-control" />
                        <span asp-validation-for="Correo" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Teléfono</label>
                        <input asp-for="Telefono" class="form-control" />
                        <span asp-validation-for="Telefono" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <a asp-action="Medicos" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Volver
                    </a>
                    <button type="submit" class="btn btn-gradient-primary">
                        <i class="bi bi-save me-1"></i>Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
