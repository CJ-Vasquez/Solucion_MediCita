@model MediCita.Web.Entidades.Medicamento
@{
    ViewData["Title"] = "Editar Medicamento";
}

<div class="container-fluid py-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-warning bg-gradient">
            <h3 class="text-white mb-0"><i class="bi bi-pencil-square me-2"></i>Editar Medicamento</h3>
        </div>
        <div class="card-body p-4">
            <form asp-action="EditarMedicamento" method="post">
                <input type="hidden" asp-for="IdMedicamento" />

                <div class="mb-3">
                    <label class="form-label">Nombre del Medicamento</label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Laboratorio</label>
                    <input asp-for="Laboratorio" class="form-control" />
                    <span asp-validation-for="Laboratorio" class="text-danger"></span>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Precio (S/.)</label>
                        <input asp-for="Precio" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="Precio" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Stock Actual</label>
                        <input asp-for="Stock" type="number" class="form-control" />
                        <span asp-validation-for="Stock" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Medicamentos" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Volver
                    </a>
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-save me-1"></i>Actualizar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
