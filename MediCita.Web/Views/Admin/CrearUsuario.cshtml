@model MediCita.Web.Entidades.Usuario
@{
    ViewData["Title"] = "Nuevo Usuario";
    var roles = ViewBag.Roles as List<MediCita.Web.Entidades.Rol> ?? new();
}

<div class="container-fluid py-4">
    <div class="card shadow-sm border-0">
        <div class="card-header" style="background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);">
            <h3 class="text-white mb-0"><i class="bi bi-person-plus me-2"></i>Registrar Usuario</h3>
        </div>
        <div class="card-body p-4">
            <form asp-action="CrearUsuario" method="post">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Nombre Completo <span class="text-danger">*</span></label>
                        <input asp-for="NombreCompleto" class="form-control" placeholder="Ej: Juan Pérez García" />
                        <span asp-validation-for="NombreCompleto" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Correo Electrónico <span class="text-danger">*</span></label>
                        <input asp-for="Correo" type="email" class="form-control" placeholder="usuario@ejemplo.com" />
                        <span asp-validation-for="Correo" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Contraseña <span class="text-danger">*</span></label>
                        <input asp-for="Clave" type="password" class="form-control" placeholder="Mínimo 6 caracteres" />
                        <span asp-validation-for="Clave" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Rol <span class="text-danger">*</span></label>
                        <select asp-for="IdRol" class="form-select">
                            <option value="">-- Seleccione un rol --</option>
                            @foreach (var r in roles)
                            {
                                <option value="@r.IdRol">@r.NombreRol</option>
                            }
                        </select>
                        <span asp-validation-for="IdRol" class="text-danger"></span>
                    </div>
                </div>

                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    <strong>Roles disponibles:</strong><br>
                    - <strong>Administrador:</strong> Acceso total al sistema<br>
                    - <strong>Médico:</strong> Gestión de citas y consultas<br>
                    - <strong>Cliente:</strong> Reserva de citas y compra de medicamentos
                </div>

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <a asp-action="Usuarios" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Volver
                    </a>
                    <button type="submit" class="btn btn-gradient-primary">
                        <i class="bi bi-save me-1"></i>Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
